[Unit]
Description=Hyperlite API (FastAPI + libvirt)
After=network-online.target libvirtd.service
Wants=network-online.target
Requires=libvirtd.service

[Service]
Type=simple
WorkingDirectory=/root/hyperlite
EnvironmentFile=/root/hyperlite/.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
# The tools Hyperlite reads (apt, df, virsh, qemu-img...) answer in English whatever the server's language, so the
# parsing of their output does not depend on it (a French server answered "fermé", "Candidat :"...). The dashboard has
# its own languages. libvirtd's messages stay in the system's language: the code reads their error codes only.
Environment=LC_ALL=C.UTF-8
# Temporary files of multipart uploads (ISOs of several GB) go to the data disk,
# NOT to /tmp: on recent Debian /tmp is a tmpfs (RAM/2), so an ISO larger than
# it fails with "error parsing the body" (seen with a RHEL 10 DVD larger than
# 7.8 GB of tmpfs).
Environment=TMPDIR=/root/hyperlite/data/tmp
# The files a newer version moved (a 1.1 rolled back to this one) come back before anything reads them.
ExecStartPre=/bin/bash /root/hyperlite/scripts/migrate_layout.sh back
ExecStartPre=/bin/mkdir -p /root/hyperlite/data/tmp
ExecStartPre=/root/hyperlite/scripts/ensure-tls-cert.sh
ExecStartPre=/root/hyperlite/scripts/write-motd.sh
ExecStart=/root/hyperlite/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --ssl-keyfile /root/hyperlite/data/tls/hyperlite.key --ssl-certfile /root/hyperlite/data/tls/hyperlite.crt --timeout-graceful-shutdown 5
# A dashboard keeps connections open (terminals, polling): without a bound on the graceful shutdown a restart
# waited up to 30 s for them, longer than the update watchdog allowed, and a good update was rolled back.
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
