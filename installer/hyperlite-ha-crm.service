[Unit]
Description=Hyperlite HA cluster resource manager (recovery and load balancing, on the leader)
Documentation=https://github.com/Hyperlite-hv/Hyperlite/blob/master/docs/design/privilege-separation.md
# Every node, acting on the leader: the recovery of a lost member's HA VMs and load balancing's evaluation
# (app/ha_services), as Proxmox VE's pve-ha-crm. Apart from the watchdog: a hang here never resets a node.
# After hyperlite-daemon and the API; PartOf: a restart or a stop of the API (an update) restarts or stops it too, so
# they run the same version, as the scheduler.
After=hyperlite-daemon.service hyperlite-cfs.service hyperlite.service
Wants=hyperlite-daemon.service
PartOf=hyperlite.service

[Service]
Type=simple
WorkingDirectory=/usr/lib/hyperlite
EnvironmentFile=-/etc/hyperlite/priv/env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
# The tools' output read in English, as the API's (installer/hyperlite.service).
Environment=LC_ALL=C.UTF-8
Environment=TMPDIR=/var/lib/hyperlite/tmp
# Its tasks' runner (app/core/tasks.py); HA runs here, not in the API.
Environment=HYPERLITE_SERVICE=ha-crm
Environment=HYPERLITE_HA_SERVICE=1
Environment=HYPERLITE_SCHEDULER_SERVICE=1
ExecStartPre=/usr/bin/test -s /etc/hyperlite/priv/env
ExecStart=/usr/lib/hyperlite/venv/bin/python -m app.ha_services crm
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
