#!/bin/bash
# Debian maintainer script (postinst), run by dpkg right after the package files
# have been placed in /root/hyperlite. It covers both a FRESH INSTALLATION
# (nothing exists yet) and an UPGRADE (the package only replaces the application
# code on top of an already configured instance). The two are told apart by the
# presence of .env (never shipped by the package, see installer/build-deb.sh):
# absent = first installation, present = upgrade, in which case the secrets are
# never regenerated. The package never touches the Linux root password.
set -e

log() { echo "[hyperlite-postinst] $*"; }

APP_DIR=/root/hyperlite
FRESH_INSTALL=0
[ ! -f "$APP_DIR/.env" ] && FRESH_INSTALL=1

mkdir -p "$APP_DIR/data/isos" "$APP_DIR/data/templates" "$APP_DIR/data/tls" "$APP_DIR/data/ssh" \
         "$APP_DIR/data/vm-exports" "$APP_DIR/data/imported-disks" "$APP_DIR/data/casper-cache" "$APP_DIR/data/tmp"
chmod +x "$APP_DIR/scripts/"*.sh 2>/dev/null || true
chmod o+x /root  # see postinstall.sh: required so libvirt-qemu can mount the ISOs under data/isos/
# /root is traversable (above), so the update backups (they hold .env, the SSH and TLS keys) must be root-only;
# earlier versions left them world-readable.
if [ -d /root/hyperlite-backups ]; then
    chmod 700 /root/hyperlite-backups
    find /root/hyperlite-backups -maxdepth 1 -name 'hyperlite-backup-*' -type f -exec chmod 600 {} +
fi

log "preflight check (system)"
PREFLIGHT="$APP_DIR/app/core/preflight.py"
if ! python3 "$PREFLIGHT" --only system --offline; then
    if [ "$FRESH_INSTALL" = "1" ]; then
        log "ERROR: blocking preflight, installation aborted before any configuration."
        exit 1
    fi
    log "WARNING: blocking preflight on an upgrade, continuing (instance already configured)."
fi

log "Python environment (venv)"
if [ ! -x "$APP_DIR/venv/bin/python3" ]; then
    python3 -m venv "$APP_DIR/venv"
fi
"$APP_DIR/venv/bin/pip" install --no-input --upgrade pip --quiet
"$APP_DIR/venv/bin/pip" install --no-input -r "$APP_DIR/requirements.txt" --quiet
# python-jose (and its vulnerable ecdsa dependency) was replaced by PyJWT and passlib by bcrypt; drop them from venvs created by older versions.
"$APP_DIR/venv/bin/pip" uninstall -y python-jose ecdsa passlib >/dev/null 2>&1 || true

log "preflight check (Python dependencies actually importable)"
if ! python3 "$PREFLIGHT" --only python --python "$APP_DIR/venv/bin/python3" --requirements "$APP_DIR/requirements.txt"; then
    log "ERROR: unusable Python dependencies, the service is not (re)started."
    exit 1
fi

if [ "$FRESH_INSTALL" = "1" ]; then
    log "first installation: generating the secrets specific to this machine"
    SECRET_KEY=$(openssl rand -hex 32)
    ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '=+/' | cut -c1-16)
    cat > "$APP_DIR/.env" <<ENVEOF
HYPERLITE_SECRET_KEY=$SECRET_KEY
HYPERLITE_INITIAL_ADMIN_PASSWORD=$ADMIN_PASSWORD
ENVEOF
    chmod 600 "$APP_DIR/.env"
    # libvirt's "default" NAT network (virbr0) is the one VMs get unless told otherwise, but Debian 13 defines it
    # without starting it: on a node installed from the package (not the ISO, whose installer already does this),
    # the first VM could not start. On an upgrade the administrator's choice is left alone.
    virsh net-autostart default >/dev/null 2>&1 || true
    virsh net-start default >/dev/null 2>&1 || true

    if [ ! -f "$APP_DIR/data/ssh/hyperlite_automation" ]; then
        ssh-keygen -t ed25519 -N "" -f "$APP_DIR/data/ssh/hyperlite_automation" -C "hyperlite-automation" -q
    fi
    chmod 700 "$APP_DIR/data/ssh"
    chmod 600 "$APP_DIR/data/ssh/hyperlite_automation" 2>/dev/null || true

    echo "$ADMIN_PASSWORD" > /root/.hyperlite-initial-password
    chmod 600 /root/.hyperlite-initial-password
    log "initial admin password: $ADMIN_PASSWORD (see also /root/.hyperlite-initial-password)"
else
    log "upgrade: existing secrets/config kept as is"
fi

# hyperlite-cfs, the replicated configuration (cfs/): built here against this system's Corosync and SQLite libraries,
# its unit installed but left disabled until a cluster is set up. Hyperlite does not use it yet, so a failed build
# is reported and the installation goes on.
log "hyperlite-cfs (replicated configuration, not used by Hyperlite yet)"
CFS_BUILT=0
if bash "$APP_DIR/scripts/build-cfs.sh" "$APP_DIR"; then
    CFS_BUILT=1
else
    log "WARNING: hyperlite-cfs could not be built (output above); Hyperlite runs as before without it."
fi

log "systemd service"
cp "$APP_DIR/installer/hyperlite.service" /etc/systemd/system/hyperlite.service
cp "$APP_DIR/installer/hyperlite-cfs.service" /etc/systemd/system/hyperlite-cfs.service
systemctl daemon-reload
# Corosync is a dependency (a cluster is created from the dashboard), but Debian's package starts it at once with its
# own sample configuration: cluster "debian", no encryption. Until Hyperlite writes its own (cluster creation or join,
# app/core/cluster_setup.py, which enables and starts it), it stays stopped.
# Told apart by its "crypto_cipher: none" too: Hyperlite's configuration always encrypts (a cluster may be named
# "debian").
conf=/etc/corosync/corosync.conf
if [ -f "$conf" ] && grep -Eq '^[[:space:]]*cluster_name:[[:space:]]*debian[[:space:]]*$' "$conf" \
    && grep -Eq '^[[:space:]]*crypto_cipher:[[:space:]]*none[[:space:]]*$' "$conf"; then
    systemctl disable --now corosync.service >/dev/null 2>&1 || true
fi
# Only a daemon an administrator started (a cluster) is restarted onto the new binary; a disabled one stays stopped.
if [ "$CFS_BUILT" = "1" ] && ! systemctl try-restart hyperlite-cfs.service; then
    log "WARNING: hyperlite-cfs did not restart: systemctl status hyperlite-cfs"
fi
systemctl enable hyperlite.service
if [ "$FRESH_INSTALL" = "1" ]; then
    systemctl start hyperlite.service
elif [ -z "$HYPERLITE_SKIP_RESTART" ]; then
    systemctl restart hyperlite.service
else
    # HYPERLITE_SKIP_RESTART: set by app/routers/update.py when this
    # installation is triggered FROM the hyperlite service itself (the "Check for
    # updates" button of the web interface). Restarting here would kill this
    # apt-get process in the middle of its own postinst. The caller restarts the
    # service right afterwards, from a detached process.
    log "restart deferred (triggered by the caller, e.g. the Hyperlite web interface)"
fi

log "done (version $(cat "$APP_DIR/VERSION" 2>/dev/null || echo '?'))"
exit 0
