#!/bin/bash
# Debian maintainer script (postinst), run by dpkg right after the package files have been placed: the code in
# /usr/lib/hyperlite, the web interface in /usr/share/hyperlite/www (app/core/paths.py). It covers both a FRESH
# INSTALLATION (nothing exists yet) and an UPGRADE (the package only replaces the code of an already configured node).
# The two are told apart by the node's keys (never shipped by the package): /etc/hyperlite/priv/env, or the .env of an
# installation up to 1.0, whose files move at the service's next start (scripts/migrate_layout.sh forward, its
# ExecStartPre, with the service stopped). Absent = first installation; present = upgrade, and the secrets are never
# regenerated. The package never touches the Linux root password.
set -e

log() { echo "[hyperlite-postinst] $*"; }

CODE=/usr/lib/hyperlite
VAR=/var/lib/hyperlite
ETC=/etc/hyperlite
PRIV=$ETC/priv
OLD=/root/hyperlite  # up to 1.0

FRESH_INSTALL=0
[ ! -f "$PRIV/env" ] && [ ! -f "$OLD/.env" ] && FRESH_INSTALL=1

chmod +x "$CODE/scripts/"*.sh 2>/dev/null || true
# Readable by libvirt-qemu down to the ISO images (template/iso); what holds secrets is closed below it.
install -d -m 755 "$VAR"

log "preflight check (system)"
if ! python3 "$CODE/app/core/preflight.py" --only system --offline; then
    if [ "$FRESH_INSTALL" = "1" ]; then
        log "ERROR: blocking preflight, installation aborted before any configuration."
        exit 1
    fi
    log "WARNING: blocking preflight on an upgrade, continuing (instance already configured)."
fi

log "Python environment (venv, built in CI and shipped in the package)"
if ! bash "$CODE/scripts/install-venv.sh" "$CODE" "$CODE"; then
    log "ERROR: unusable Python dependencies, the service is not (re)started."
    exit 1
fi

if [ "$FRESH_INSTALL" = "1" ]; then
    log "first installation: generating the secrets specific to this machine"
    install -d -m 755 "$ETC"
    install -d -m 700 "$PRIV" "$PRIV/ssh" "$ETC/local"
    install -d -m 755 "$VAR/template" "$VAR/template/iso" "$VAR/template/vm" "$VAR/dump" "$VAR/import" "$VAR/tmp"
    SECRET_KEY=$(openssl rand -hex 32)
    ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '=+/' | cut -c1-16)
    (umask 077 && cat > "$PRIV/env" <<ENVEOF
HYPERLITE_SECRET_KEY=$SECRET_KEY
HYPERLITE_INITIAL_ADMIN_PASSWORD=$ADMIN_PASSWORD
ENVEOF
    )
    chmod 600 "$PRIV/env"
    # libvirt's "default" NAT network (virbr0) is the one VMs get unless told otherwise, but Debian 13 defines it
    # without starting it: on a node installed from the package (not the ISO, whose installer already does this),
    # the first VM could not start. On an upgrade the administrator's choice is left alone.
    virsh net-autostart default >/dev/null 2>&1 || true
    virsh net-start default >/dev/null 2>&1 || true

    if [ ! -f "$PRIV/ssh/hyperlite_automation" ]; then
        ssh-keygen -t ed25519 -N "" -f "$PRIV/ssh/hyperlite_automation" -C "hyperlite-automation" -q
    fi
    chmod 600 "$PRIV/ssh/hyperlite_automation"

    echo "$ADMIN_PASSWORD" > /root/.hyperlite-initial-password
    chmod 600 /root/.hyperlite-initial-password
    # Never the password itself: dpkg's output is kept in /var/log/apt/term.log, readable by the adm group.
    log "initial admin password: in /root/.hyperlite-initial-password (changed at the first sign-in)"
else
    log "upgrade: existing secrets/config kept as is"
    if [ -f "$OLD/.env" ]; then
        log "the files of $OLD move to $VAR and $ETC at the service's next start"
    fi
fi

# hyperlite-cfs, the replicated configuration: built in CI, shipped at /usr/lib/hyperlite/hyperlite-cfs. Its unit is
# installed but left disabled until a cluster is set up. Older versions built it on the node into /usr/local/sbin:
# that name now points at the shipped one, for the scripts that still use it.
log "hyperlite-cfs (replicated configuration)"
ln -sfn "$CODE/hyperlite-cfs" /usr/local/sbin/hyperlite-cfs
rm -rf "$OLD/data/cfs-build" "$OLD/data/cfs-build.log"

# SPICE consoles (docs/design/spice-console.md): this node's SPICE certificates and QEMU's TLS setting. A failure
# leaves SPICE unavailable on this node, never the installation.
if ! bash "$CODE/scripts/ensure-spice-tls.sh"; then
    log "WARNING: SPICE consoles could not be set up on this node: bash $CODE/scripts/ensure-spice-tls.sh"
fi

# libvirt's qemu hooks: the VLANs of VMs on VLAN-aware Linux bridges (docs/design/network.md) and the VMs' hook
# scripts (docs/design/hook-scripts.md). A failure leaves them unset on this node, never the installation.
if ! bash "$CODE/scripts/ensure-libvirt-hooks.sh"; then
    log "WARNING: libvirt's hooks could not be installed on this node: bash $CODE/scripts/ensure-libvirt-hooks.sh"
fi

# Backups into a backup store (docs/design/backup-store.md): QEMU may bind a running VM's export. A failure leaves
# backups of running VMs into a store unavailable on this node, never the installation.
if ! bash "$CODE/scripts/ensure-backup-apparmor.sh"; then
    log "WARNING: backups of running VMs into a store need: bash $CODE/scripts/ensure-backup-apparmor.sh"
fi

log "systemd service"
cp "$CODE/installer/hyperlite.service" /etc/systemd/system/hyperlite.service
cp "$CODE/installer/hyperlite-cfs.service" /etc/systemd/system/hyperlite-cfs.service
cp "$CODE/installer/hyperlite-daemon.service" /etc/systemd/system/hyperlite-daemon.service
cp "$CODE/installer/hyperlite-vlan-bridges.service" /etc/systemd/system/hyperlite-vlan-bridges.service
systemctl daemon-reload
# Runs at boot only when a bridge was made VLAN-aware from the dashboard (its list exists): nothing to start now.
systemctl enable hyperlite-vlan-bridges.service
# Corosync is a dependency (a cluster is created from the dashboard), but Debian's package starts it at once with its
# own sample configuration: cluster "debian", no encryption. Until Hyperlite writes its own (cluster creation or join,
# app/core/cluster_setup.py, which enables and starts it), it stays stopped.
# Told apart by its "crypto_cipher: none" too: Hyperlite's configuration always encrypts (a cluster may be named
# "debian").
conf=/etc/corosync/corosync.conf
if [ -f "$conf" ] && grep -Eq '^[[:space:]]*cluster_name:[[:space:]]*debian[[:space:]]*$' "$conf" \
    && grep -Eq '^[[:space:]]*crypto_cipher:[[:space:]]*none[[:space:]]*$' "$conf"; then
    systemctl disable --now corosync.service >/dev/null 2>&1 || true
fi
# Debian's security updates every night (03:30), never a reboot, never Hyperlite itself: Antho's decision for every
# node (docs/design/updates-1.0.md). Only on a node that never chose; changed on Node > Updates.
if ! ( cd "$CODE" && "$CODE/venv/bin/python3" -c \
    "from app.core.host_system import ensure_auto_updates_default; ensure_auto_updates_default()" ) >/dev/null 2>&1; then
    log "WARNING: the night security updates could not be set up (Node > Updates)."
fi
# Only a daemon an administrator started (a cluster) is restarted onto the new binary; a disabled one stays stopped.
if ! systemctl try-restart hyperlite-cfs.service; then
    log "WARNING: hyperlite-cfs did not restart: systemctl status hyperlite-cfs"
fi
# hyperlite-daemon: the root side of the API (docs/design/privilege-separation.md). Restarting it never touches the
# API process, so it is restarted even when the API defers its own restart.
systemctl enable hyperlite-daemon.service
if ! systemctl restart hyperlite-daemon.service; then
    log "WARNING: hyperlite-daemon did not start: systemctl status hyperlite-daemon"
fi
systemctl enable hyperlite.service
if [ "$FRESH_INSTALL" = "1" ]; then
    systemctl start hyperlite.service
elif [ -z "$HYPERLITE_SKIP_RESTART" ]; then
    systemctl restart hyperlite.service
else
    # HYPERLITE_SKIP_RESTART: set by app/routers/update.py when this
    # installation is triggered FROM the hyperlite service itself (the "Check for
    # updates" button of the web interface). Restarting here would kill this
    # apt-get process in the middle of its own postinst. The caller restarts the
    # service right afterwards, from a detached process.
    log "restart deferred (triggered by the caller, e.g. the Hyperlite web interface)"
fi

log "done (version $(cat "$CODE/VERSION" 2>/dev/null || echo '?'))"
exit 0
