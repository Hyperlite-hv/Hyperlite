[Unit]
Description=Hyperlite daemon (the operations that need root, behind a local socket)
Documentation=https://github.com/Hyperlite-hv/Hyperlite/blob/master/docs/design/privilege-separation.md
After=libvirtd.service
Before=hyperlite.service

[Service]
# Ready once its socket answers (app/daemon/server.py, notify_ready): the API, after it, writes through it.
Type=notify
WorkingDirectory=/usr/lib/hyperlite
# The node's settings the API's unit loads too: the copy to hyperlite-cfs runs here (app/daemon/ops/cfs.py) and reads
# whether it is forced on (HYPERLITE_CFS_SHADOW) and the daemon's socket, as the API did.
EnvironmentFile=-/etc/hyperlite/priv/env
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
# /run/hyperlite: the socket, 0660 root and the API's group (app/daemon/server.py). Nothing listens on the network.
RuntimeDirectory=hyperlite
RuntimeDirectoryMode=0755
ExecStart=/usr/lib/hyperlite/venv/bin/python -m app.daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
