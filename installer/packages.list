# Debian packages an appliance installed from the ISO gets, besides the hyperlite package and its own dependencies
# (installer/deb/control.template). One per line; # starts a comment, also at the end of a line.
#
# installer/build-offline-bundle.sh puts them, with every dependency, on the ISO, and installer/postinstall.sh
# installs them from there: the installation needs no network, as with Proxmox.

# Access and administration. The console keyboard: the installer cannot install it from the CD without a
# network mirror, so it comes from here (hyperlite-questions.sh writes the layout chosen in the installer).
console-setup
keyboard-configuration
openssh-server
sudo
curl
ca-certificates
gnupg

# Python: the hyperlite package carries its environment and hyperlite-cfs, built in CI (docs/design/clean-package.md),
# so nothing is built on the node and no compiler is installed.
python3
python3-venv

# Virtualisation
qemu-kvm
qemu-utils
libvirt-daemon-system
libvirt-daemon-driver-lxc  # the Containers tab: libvirt-daemon-system does not pull it in
libvirt-clients
bridge-utils
ovmf
swtpm
swtpm-tools

# Images, cloud-init and containers
genisoimage
sshpass
cloud-image-utils
debootstrap
skopeo
umoci
xorriso

# Storage: NFS pools are the base of live migration. The server stays disabled until /etc/exports is configured.
nfs-common
nfs-kernel-server

# Cluster: creating or joining a cluster from the dashboard needs Corosync
corosync
