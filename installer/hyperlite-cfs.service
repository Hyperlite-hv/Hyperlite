[Unit]
Description=Hyperlite replicated cluster configuration (hyperlite-cfs)
Documentation=https://github.com/Hyperlite-hv/Hyperlite/blob/master/cfs/README.md
# Enabled on every node (docs/design/cfs-files.md, section 7): it holds the node's own files, even on a single node.
# Local mode (the default) needs nothing else. Cluster mode (HYPERLITE_CFS_MODE=--cluster in /etc/default/hyperlite-cfs) joins the local
# Corosync's process group; Corosync and its configuration come with setting up a cluster.
After=corosync.service
# Never give up restarting it: in a cluster it exits when Corosync goes away (an upgrade, a crash) and must come back
# once Corosync does, however long that takes (the default stops after 5 restarts in 10 s, about 10 s of outage).
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HYPERLITE_CFS_MODE=
EnvironmentFile=-/etc/default/hyperlite-cfs
# The socket's group is the API's (www-data from 4e), which reads the replicated configuration; only root changes it,
# (docs/design/privilege-separation.md, section 14.7).
# The tree as read-only files (docs/design/cfs-files.md): at /etc/hyperlite once the node's files are in
# it, at /etc/hyperlite/cfs before (scripts/cfs-start.sh). Ready once mounted (scripts/cfs-wait.sh): what starts after
# it reads the node's files there. A mount that fails is logged; the socket is served.
ExecStart=/usr/lib/hyperlite/scripts/cfs-start.sh
ExecStartPost=/usr/lib/hyperlite/scripts/cfs-wait.sh
StateDirectory=hyperlite-cfs
StateDirectoryMode=0700
RuntimeDirectory=hyperlite-cfs
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
