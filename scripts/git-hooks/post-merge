#!/bin/bash
# Automatic publication of the APT repository, following the same principle as
# Proxmox's INTERNAL build infrastructure: the GPG signing key NEVER leaves the
# dedicated development/publishing machine, and no third-party CI (GitHub
# Actions...) ever has access to it. In exchange there is nothing to remember
# manually: this hook fires automatically as soon as `master` advances on this
# machine (after `git pull`, including a plain fast-forward: standard post-merge
# behaviour).
#
# Installation (not automatic, `.git/hooks/` is never tracked by Git):
#   ln -sf ../../scripts/git-hooks/post-merge <repo>/.git/hooks/post-merge
#   chmod +x <repo>/.git/hooks/post-merge
#
# Optional local configuration: a `.publish.env` file at the repository root
# (never committed, listed in .gitignore) may export HYPERLITE_APT_URL, the
# address of the APT repository baked into the ISO (see installer/build-iso.sh).
# Without it the ISO uses the public mirror.
#
# The version is generated automatically (timestamp to the minute) rather than
# relying on someone remembering to bump VERSION by hand: every distinct commit
# on master gets its own published version. It runs in the BACKGROUND (detached
# from the git process itself): a `git pull` must never stay blocked for a
# minute or more while the build and signing run.

REPO_DIR="$(git rev-parse --show-toplevel)"
cd "$REPO_DIR" || exit 0
# shellcheck disable=SC1091
[ -f "$REPO_DIR/.publish.env" ] && . "$REPO_DIR/.publish.env"
export HYPERLITE_APT_URL

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
[ "$BRANCH" != "master" ] && exit 0

(
    LOG="/root/hyperlite-backups/publish.log"
    mkdir -p /root/hyperlite-backups
    MARKER="$REPO_DIR/.last-published-commit"
    CURRENT_COMMIT="$(git rev-parse HEAD)"

    # Already published for this exact commit: avoids a useless rebuild/republish
    # if post-merge fires several times without any real new content (e.g. a
    # `git pull` that brings nothing new).
    if [ -f "$MARKER" ] && [ "$(cat "$MARKER")" = "$CURRENT_COMMIT" ]; then
        exit 0
    fi

    {
        echo "[post-merge $(date -u +%FT%TZ)] New master commit ($CURRENT_COMMIT), automatic publication..."

        echo "$(date -u +%Y.%m.%d.%H%M)" > VERSION

        # The exit code of every step is checked explicitly: without it, a REAL
        # failure (e.g. xorriso missing, git identity not configured) would be
        # followed by "successfully republished" messages anyway, because the
        # following lines of the script keep running and the final echoes are
        # unconditional.
        if ! bash installer/build-deb.sh; then
            echo "[post-merge] ERROR: build-deb.sh failed, publication cancelled"
            exit 1
        fi
        if ! bash installer/build-apt-repo.sh; then
            echo "[post-merge] ERROR: build-apt-repo.sh failed, publication cancelled"
            exit 1
        fi

        # Republishes to gh-pages through a temporary worktree. Deliberately
        # best-effort (a failure is not fatal for the rest of the script): this
        # mirror is not the source used by postinstall.sh by default when a
        # single-origin repository is configured (see the note about GitHub
        # Pages CDN consistency in installer/build-apt-repo.sh), but a failure is
        # announced rather than silently ignored.
        # `git worktree add "$WORKTREE" gh-pages` only advances the LOCAL
        # `gh-pages` branch on the very FIRST run (it is then created tracking
        # origin/gh-pages); later runs reuse that local branch FROZEN at its
        # starting point even if `origin/gh-pages` has advanced since (e.g.
        # another machine also publishing), and the push is then rejected
        # ("fetch first"). `-B` forces the local `gh-pages` branch to match
        # `origin/gh-pages` on EVERY run before applying the new files. This is
        # safe: it is only a generated mirror (a full rsync --delete each time),
        # with no local history to preserve.
        git fetch origin gh-pages --quiet
        WORKTREE="$(mktemp -d)"
        git worktree add "$WORKTREE" -B gh-pages origin/gh-pages
        rsync -a --delete --exclude=.git installer/apt-repo/ "$WORKTREE/"
        if (
            cd "$WORKTREE" || exit 1
            if ! git diff --quiet || [ -n "$(git status --porcelain)" ]; then
                git add -A
                git commit -m "Automatic publication $(cat "$REPO_DIR/VERSION") (post-merge, commit ${CURRENT_COMMIT:0:8})" --quiet
                git push origin gh-pages
            fi
        ); then
            echo "[post-merge] gh-pages mirror republished"
        else
            echo "[post-merge] WARNING: republication to gh-pages failed (non-blocking)"
        fi
        git worktree remove "$WORKTREE" --force

        # Commits the VERSION bump on master itself. Without it the working tree
        # would stay "dirty" permanently (VERSION modified but not committed),
        # which would silently break the existing update button of a Git-mode
        # installation (_is_dirty() blocks any update as soon as a single file is
        # modified).
        git add VERSION
        git commit -m "Version $(cat VERSION) (automatic post-merge publication)" --quiet
        if ! git push origin master --quiet; then
            echo "[post-merge] ERROR: pushing the VERSION bump to master failed: the working tree will stay dirty (VERSION committed locally but not pushed), fix it manually"
            exit 1
        fi

        # Also rebuilds and republishes the installation ISO, on the same
        # automatic cadence as the APT repository above (about 25 s of build,
        # negligible in the background at every merge). A SINGLE, STABLE GitHub
        # release ("appliance-iso-latest", not a new tag per commit, which would
        # pile up dozens of ~950 MB releases): the download link NEVER changes,
        # only the file and the notes are replaced at each publication. The
        # underlying git tag is NOT moved each time (moving an existing tag
        # requires a force-push, judged unnecessary here): the exact commit is
        # recorded in the release notes instead.
        if bash installer/build-iso.sh installer/hyperlite-appliance-amd64.iso && [ -f installer/hyperlite-appliance-amd64.iso ]; then
            ISO_BUILT=1
        else
            ISO_BUILT=0
            echo "[post-merge] WARNING: build-iso.sh failed or produced no file: ISO NOT republished this time (the GitHub release keeps its previous content, no false status)"
        fi
        ISO_TAG="appliance-iso-latest"
        ISO_NOTES="Unattended installation ISO of the Hyperlite appliance (Debian 13, preseed installer), rebuilt and republished automatically at EVERY change on master (stable download link, always the latest version).

Version at the time of this publication: $(cat VERSION) (commit ${CURRENT_COMMIT:0:8}).

Once installed, the appliance manages itself through apt (the same repository as above, see dists/): the 'Check for updates' button of the dashboard works normally from the first boot, regardless of the date of this ISO.

Installation:
sudo dd if=hyperlite-appliance-amd64.iso of=/dev/sdX bs=4M status=progress conv=fsync
(or Rufus / balenaEtcher on Windows)

The installer asks for the root password. The Hyperlite `admin` account gets a random initial password shown on the console banner and in /root/.hyperlite-initial-password.

A single manual confirmation is required during the installation (LVM confirmation screen: a deliberate Debian Installer safeguard against data loss, which cannot be bypassed by preseed)."

        if [ "$ISO_BUILT" = "1" ]; then
            if gh release view "$ISO_TAG" >/dev/null 2>&1; then
                if gh release upload "$ISO_TAG" installer/hyperlite-appliance-amd64.iso --clobber && gh release edit "$ISO_TAG" --notes "$ISO_NOTES"; then
                    echo "[post-merge] ISO republished successfully (release $ISO_TAG, version $(cat VERSION))"
                else
                    echo "[post-merge] ERROR: uploading/editing the existing ISO release failed"
                fi
            else
                if gh release create "$ISO_TAG" installer/hyperlite-appliance-amd64.iso --title "Appliance ISO (latest)" --notes "$ISO_NOTES" --target master; then
                    echo "[post-merge] ISO republished successfully (release $ISO_TAG, version $(cat VERSION))"
                else
                    echo "[post-merge] ERROR: creating the ISO release failed"
                fi
            fi
        fi

        git rev-parse HEAD > "$MARKER"
        echo "[post-merge] APT repository republished successfully: version $(cat VERSION)"
    } >> "$LOG" 2>&1
) &
disown
